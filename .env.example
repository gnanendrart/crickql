# Copy to .env and fill in. Never commit .env.

# Claude API
ANTHROPIC_API_KEY=
SQL_MODEL=claude-sonnet-5-5
FAST_MODEL=claude-haiku-5-5

# Which warehouse the agent queries: pg or snowflake
WAREHOUSE=pg

# Local PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_DB=crickql
PG_USER=
PG_PASSWORD=

# Snowflake (Week 2)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_WAREHOUSE=DEV_WH
SNOWFLAKE_DATABASE=CRICKQL
SNOWFLAKE_ROLE=

# AWS S3 raw landing (Week 2)
AWS_PROFILE=default
AWS_REGION=ca-central-1
S3_BUCKET=

# Cricsheet
CRICSHEET_URL=https://cricsheet.org/downloads/ipl_json.zip
